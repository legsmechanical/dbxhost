 			for slot, params := range slotChanges {
 				update := wsParamUpdate{Type: "param_update", Slot: slot, Params: params}
 				for _, c := range clients {
@@ -1213,7 +1323,7 @@ func (ru *RemoteUI) notifyLoop(ctx context.Context) {
