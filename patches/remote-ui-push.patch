+					// newer one.
+					ru.mu.Lock()
+					ru.lastToolNotify = time.Now()
+					ru.mu.Unlock()
+					select {
+					case ru.toolKick <- c.Value:
+					default:
+						select {
+						case <-ru.toolKick:
+						default:
+						}
+						select {
+						case ru.toolKick <- c.Value:
+						default:
+						}
+					}
