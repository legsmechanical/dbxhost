From 25854afa2c54ba00f4304edf98ab9626986c7170 Mon Sep 17 00:00:00 2001
From: legsmechanical <joshgaine@gmail.com>
Date: Sat, 18 Jul 2026 10:48:49 -0400
Subject: [PATCH] fix(manager,shim): push transport-stop edge to the remote UI
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Hands-on testing found: the browser playhead kept animating well after
pressing stop. Two halves of the same gap — rui_play pushes are the browser's
only source of the on flag, and neither pusher delivered the stop edge:

- manager: serviceToolClients early-returned on on=0 before the playhead
  fan-out, so the on->off transition was never sent (latent since c29abdf7).
  New per-client toolLastOn cursor; a play-state edge now pushes even when
  stopped, and the moving tick still pushes only while playing.
- shim probe: only rev changes pushed immediately; an on-flip with unchanged
  rev classed as playhead-only and took the every-8th-changed-probe divider —
  but after stop the digest freezes, so that deferred push NEVER came. The on
  field now classes as immediate alongside rev.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_015f8H1BbPTkWyhPv2zphzhR
---
 schwung-manager/remote_ui.go | 17 ++++++++++-------
 src/schwung_shim.c           | 12 +++++++++++-
 2 files changed, 21 insertions(+), 8 deletions(-)

diff --git a/schwung-manager/remote_ui.go b/schwung-manager/remote_ui.go
index 7cfa0495..0665fc1c 100644
--- a/schwung-manager/remote_ui.go
+++ b/schwung-manager/remote_ui.go
@@ -77,6 +77,7 @@ type ruClient struct {
 	toolSynced   bool
 	toolLastRev  int64
 	toolLastTick int64
+	toolLastOn   bool // last pushed play-state; start/stop EDGES must be pushed
 }
 
 // per-slot cached state used by the poll loop.
@@ -942,33 +943,35 @@ func (ru *RemoteUI) serviceToolClients(ctx context.Context, shm *ShmParams, clie
 				c.toolSynced = true
 				c.toolLastRev = rev
 				c.toolLastTick = tick
+				c.toolLastOn = on
 				c.mu.Unlock()
 			}
 		}
 		return true
 	}
 
-	// No content change → push only the moving playhead while playing (cheap).
-	if !on {
-		return false
-	}
+	// No content change → push the playhead. While playing that's the moving
+	// tick; a play-STATE edge must also be pushed even when on=false — without
+	// the stop edge the browser's animated playhead free-runs long after
+	// transport stops (rui_play pushes are its only source of the on flag).
 	play := fmt.Sprintf("%d:%d:%d", boolToInt(on), tick, bpm)
 	for _, c := range clients {
 		c.mu.Lock()
-		changed := tick != c.toolLastTick
+		changed := on != c.toolLastOn || (on && tick != c.toolLastTick)
 		c.mu.Unlock()
 		if !changed {
 			continue
