{
  "_comment": "Project settings for sessions rooted at dbxhost/. Claude Code does NOT walk parent directories for settings the way it does for CLAUDE.md, so anything configured in the workspace folder above this one does not apply here. Keep this file free of personal paths and of anything naming the private working-notes folder - it is committed to a public repo.",
  "permissions": {
    "allow": [
      "Bash(ssh ableton@move.local:*)",
      "Bash(ssh root@move.local:*)",
      "Bash(ssh -o ConnectTimeout=5 ableton@move.local:*)",
      "Bash(ssh -o ConnectTimeout=5 root@move.local:*)",
      "Bash(ssh ableton@172.16.254.1:*)",
      "Bash(ssh root@172.16.254.1:*)",
      "Bash(scp:*)",
      "Bash(standalone/scripts/install-sa.sh:*)",
      "Bash(standalone/scripts/install-host.sh:*)",
      "Bash(davebox/scripts/install_sound.sh:*)",
      "Bash(scripts/restart_move.sh:*)",
      "Bash(scripts/test-linux.sh:*)",
      "Bash(./standalone/scripts/install-sa.sh:*)",
      "Bash(./standalone/scripts/install-host.sh:*)",
      "Bash(./davebox/scripts/install_sound.sh:*)",
      "Bash(./scripts/restart_move.sh:*)",
      "Bash(./scripts/test-linux.sh:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/dirty-tree-guard.sh"
          }
        ]
      }
    ]
  }
}
