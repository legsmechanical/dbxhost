#!/usr/bin/env bash
# Pre-commit gate: run the checks that cover WHAT WAS STAGED, and never pass
# because a tool was missing.
#
# WHY IT IS SHAPED THIS WAY. The previous version ran the whole tests/host
# suite plus go vet/build/test on EVERY commit, and nothing else. Measured over
# 30 days: davebox/ took 2508 file touches and had no gate at all, while
# schwung-manager/ took 3 and was checked on all ~974 commits. The gate was
# inverted with respect to both the work and the risk.
#
# It also degraded OPEN: a missing rg/cc/go skipped that block and the commit
# passed. 'go' is not installed on the primary dev machine, so the Go block had
# been silently skipping indefinitely. A green hook must mean the checks ran.
#
# Install:                 ./scripts/install-hooks.sh
#   (equivalently: git config core.hooksPath scripts/hooks)
# Bypass one commit:       git commit --no-verify
# Skip via env:            SCHWUNG_SKIP_HOOKS=1 git commit ...
#
# ⚠ This runs NATIVELY (macOS here, Linux in CI). It cannot see platform
# differences in C — sigset_t and friends. Before pushing, run the parity
# suite:  scripts/test-linux.sh
set -uo pipefail

if [ "${SCHWUNG_SKIP_HOOKS:-0}" = "1" ]; then
  echo "[pre-commit] SCHWUNG_SKIP_HOOKS=1 — skipping"
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] && touches() { printf '%s\n' "$staged" | grep -qE "$1"; } || touches() { return 1; }

fail=0
ran=""

need() {  # need <tool> <what it gates> — fail closed, never skip
  if command -v "$1" >/dev/null 2>&1; then return 0; fi
  echo "[pre-commit] MISSING '$1' — required to check $2." >&2
  echo "             Install it, or bypass deliberately with SCHWUNG_SKIP_HOOKS=1." >&2
  fail=1
  return 1
}

# ------------------------------------------------------------ local private checks
# A clone may carry checks that are not part of this repo (a local file beside
# this one, excluded from git). Run it when present; its refusal fails the commit.
if [ -x scripts/hooks/pre-commit-private ]; then
  scripts/hooks/pre-commit-private || fail=1
fi

# ------------------------------------------------------------- host / C / shell
if touches '^(src/|tests/host/|tests/(shadow|store|build)/|standalone/|scripts/|Makefile|tests/Makefile)'; then
  echo "[pre-commit] host-tests (unit + contract) …"
  ran="$ran host"
  if need cc "the host C units" && need rg "the host source pins"; then
    if ! out=$(make -C tests/host test 2>&1); then
      echo "  FAIL: make -C tests/host test"; printf '%s\n' "$out" | sed 's/^/    /'
      fail=1
    fi
    for t in tests/host/*.sh; do
      if ! out=$(bash "$t" 2>&1); then
        echo "  FAIL: $t"; printf '%s\n' "$out" | sed 's/^/    /'
        fail=1
      fi
    done
    # tests/{shadow,store,build} pin src/, and were run by nothing until
    # 2026-09-16. Held against tests/known-failing.txt, which may only shrink.
    if ! out=$(bash tests/run-ungated.sh 2>&1); then
      echo "  FAIL: tests/run-ungated.sh"; printf '%s\n' "$out" | sed 's/^/    /'
      fail=1
    fi
  fi
fi

# ------------------------------------------------------------------- davebox
if touches '^davebox/'; then
  echo "[pre-commit] davebox tests (C units + JS units + invariants) …"
  ran="$ran davebox"
  if need cc "the davebox C units"; then
    if ! out=$(bash davebox/tests/run.sh 2>&1); then
      echo "  FAIL: davebox/tests/run.sh"; printf '%s\n' "$out" | tail -40 | sed 's/^/    /'
      fail=1
    fi
  fi
fi

# ------------------------------------------------------------- schwung-manager
if touches '^schwung-manager/'; then
  echo "[pre-commit] go (schwung-manager) …"
  ran="$ran go"
  if command -v go >/dev/null 2>&1; then
    if ! out=$(cd schwung-manager && go vet ./... && go build ./... && go test ./... 2>&1); then
      echo "  FAIL: go checks"; printf '%s\n' "$out" | sed 's/^/    /'
      fail=1
    fi
  elif command -v docker >/dev/null 2>&1 && docker version >/dev/null 2>&1; then
    # Same fallback scripts/build.sh uses when go is not installed locally.
    # Pin matches .github/workflows/ci.yml.
    echo "  (no local go — using golang:1.26-bookworm)"
    mkdir -p .cache/go-cache .cache/go-mod-cache
    if ! out=$(docker run --rm \
        -v "$PWD/schwung-manager:/src" \
        -v "$PWD/.cache/go-cache:/gocache" \
        -v "$PWD/.cache/go-mod-cache:/go-mod-cache" \
        -u "$(id -u):$(id -g)" -w /src \
        -e GOCACHE=/gocache -e GOMODCACHE=/go-mod-cache -e GOFLAGS=-buildvcs=false \
        golang:1.26-bookworm \
        bash -c 'go vet ./... && go build ./... && go test ./...' 2>&1); then
      echo "  FAIL: go checks (container)"; printf '%s\n' "$out" | tail -40 | sed 's/^/    /'
      fail=1
    fi
  else
    echo "[pre-commit] MISSING both 'go' and a running docker — cannot check schwung-manager." >&2
    echo "             Install one, or bypass deliberately with SCHWUNG_SKIP_HOOKS=1." >&2
    fail=1
  fi
fi

if [ -z "$ran" ]; then
  echo "[pre-commit] nothing staged that these checks cover — OK"
  exit 0
fi

if [ "$fail" -ne 0 ]; then
  echo "[pre-commit] FAILED. Fix the above, or bypass with: git commit --no-verify" >&2
  exit 1
fi

echo "[pre-commit] OK —$ran"
