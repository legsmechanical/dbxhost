{
    "id": "davebox-sound",
    "name": "dAVEBOx",
    "version": "0.0.1",
    "abbrev": "dAVEBOx",
    "description": "Creative 8-track MIDI sequencer with per-clip effects chains, live performance modes and sound editing. Sessions use the seq8sa prefix and are deliberately not shared with dAVEBOx Legacy.",
    "hidden": true,
    "author": "legsmechanical",
    "api_version": 2,
    "ui": "ui.js",
    "dsp": "dsp.so",
    "component_type": "tool",
    "tool_config": {
        "interactive": true,
        "skip_file_browser": true,
        "overtake": true
    },
    "capabilities": {
        "midi_in": true,
        "midi_out": true,
        "aftertouch": true,
        "button_passthrough": [
            79
        ],
        "claims_master_knob": true,
        "suspend_keeps_js": true,
        "suspend_self_managed": true
    }
}
